# Demo mode runs without environment variables.
# Set a public RPC URL only after verifying the Chog network and collection details.
VITE_PUBLIC_RPC_URL=
# A public collection contract address, once verified. Never put private keys here.
VITE_CHOG_COLLECTION_ADDRESS=
# Backend URL for a future server-verified credit ledger and persisted gallery.
VITE_API_BASE_URL=
